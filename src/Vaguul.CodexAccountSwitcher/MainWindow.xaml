<Window x:Class="Vaguul.CodexAccountSwitcher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Codex Account Switcher · Vaguul" Height="650" Width="920"
        MinHeight="520" MinWidth="720" WindowStartupLocation="CenterScreen"
        Background="#111315" Foreground="#F5F7F8" FontFamily="Segoe UI">
    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="CODEX ACCOUNT SWITCHER" Foreground="#68D391" FontSize="12" FontWeight="Bold"/>
                <TextBlock Text="Accounts" FontSize="30" FontWeight="SemiBold" Margin="0,5,0,0"/>
                <TextBlock Text="Local, encrypted profiles for Codex on Windows" Foreground="#A9B0B6" FontSize="14" Margin="0,6,0,0"/>
            </StackPanel>
            <Button Grid.Column="1" x:Name="SaveActiveButton" Click="SaveActiveButton_Click"
                    Content="Save active account" Background="#F5F7F8" Foreground="#111315" BorderThickness="0"/>
        </Grid>

        <Border Grid.Row="1" Background="#1B1E21" BorderBrush="#30353A" BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,24,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Ellipse x:Name="ActiveDot" Width="10" Height="10" Fill="#6B737B" VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1" Margin="12,0">
                    <TextBlock Text="ACTIVE IN CODEX" FontSize="10" Foreground="#8E979F" FontWeight="Bold"/>
                    <TextBlock x:Name="ActiveAccountText" Text="Checking..." FontSize="15" Margin="0,3,0,0"/>
                </StackPanel>
                <Button Grid.Column="2" Content="Refresh" Click="RefreshButton_Click" Background="Transparent" Foreground="#DCE1E5" BorderBrush="#4A5158"/>
            </Grid>
        </Border>

        <ListBox Grid.Row="2" x:Name="ProfileList" Background="Transparent" BorderThickness="0"
                 Foreground="#F5F7F8" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    <Setter Property="Margin" Value="0,0,0,8"/>
                    <Setter Property="Padding" Value="0"/>
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border Background="#191C1F" BorderBrush="#30353A" BorderThickness="1" CornerRadius="6" Padding="16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Width="5" Height="38" CornerRadius="2" Background="{Binding ColorHex}"/>
                            <StackPanel Grid.Column="1" Margin="14,0">
                                <TextBlock Text="{Binding DisplayName}" FontSize="16" FontWeight="SemiBold"/>
                                <TextBlock Text="Protected by Windows DPAPI" FontSize="12" Foreground="#8E979F" Margin="0,4,0,0"/>
                            </StackPanel>
                            <TextBlock Grid.Column="2" Text="SELECT" Foreground="#8E979F" FontSize="10" FontWeight="Bold" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <Grid Grid.Row="3" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button Content="Delete" Click="DeleteButton_Click" Background="Transparent" Foreground="#F4A6A6" BorderBrush="#684040"/>
            <TextBlock Grid.Column="1" x:Name="StatusText" Text="Ready" Foreground="#8E979F" VerticalAlignment="Center" Margin="16,0" TextTrimming="CharacterEllipsis"/>
            <Button Grid.Column="2" Content="Switch to selected" Click="SwitchButton_Click" Background="#2563EB" Foreground="White" BorderThickness="0"/>
        </Grid>
    </Grid>
</Window>
