<Window x:Class="Vaguul.CodexAccountSwitcher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Codex Account Switcher · Vaguul" Height="650" Width="920"
        MinHeight="520" MinWidth="720" WindowStartupLocation="CenterScreen"
        Background="#111315" Foreground="#F5F7F8" FontFamily="Segoe UI">
    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="CODEX ACCOUNT SWITCHER" Foreground="#68D391" FontSize="12" FontWeight="Bold"/>
                <TextBlock Text="Accounts" FontSize="30" FontWeight="SemiBold" Margin="0,5,0,0"/>
                <TextBlock Text="Local, encrypted profiles for Codex on Windows" Foreground="#A9B0B6" FontSize="14" Margin="0,6,0,0"/>
            </StackPanel>
            <Button Grid.Column="1" x:Name="SaveActiveButton" Click="SaveActiveButton_Click"
                    Content="Save active account" Background="#F5F7F8" Foreground="#111315" BorderThickness="0"
                    Height="42" MinWidth="168" VerticalAlignment="Top"/>
        </Grid>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,16,0,0">
            <Button x:Name="BrowserLoginButton" Content="Add account with browser" Click="BrowserLoginButton_Click"
                    Background="Transparent" Foreground="#DCE1E5" BorderBrush="#4A5158"/>
            <Button x:Name="ExportButton" Content="Export profiles" Click="ExportButton_Click"
                    Background="Transparent" Foreground="#DCE1E5" BorderBrush="#4A5158" Margin="8,0,0,0"/>
            <Button x:Name="ImportButton" Content="Import profiles" Click="ImportButton_Click"
                    Background="Transparent" Foreground="#DCE1E5" BorderBrush="#4A5158" Margin="8,0,0,0"/>
        </StackPanel>

        <Border Grid.Row="2" Background="#1B1E21" BorderBrush="#30353A" BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,16,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Ellipse x:Name="ActiveDot" Width="10" Height="10" Fill="#6B737B" VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1" Margin="12,0">
                    <TextBlock Text="ACTIVE IN CODEX" FontSize="10" Foreground="#8E979F" FontWeight="Bold"/>
                    <TextBlock x:Name="ActiveAccountText" Text="Checking..." FontSize="15" Margin="0,3,0,0"/>
                </StackPanel>
                <Button Grid.Column="2" x:Name="RefreshButton" Content="Refresh usage" Click="RefreshButton_Click" Background="Transparent" Foreground="#DCE1E5" BorderBrush="#4A5158" Height="36"/>
            </Grid>
        </Border>

        <ListBox Grid.Row="3" x:Name="ProfileList" SelectionChanged="ProfileList_SelectionChanged" Background="Transparent" BorderThickness="0"
                 Foreground="#F5F7F8" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    <Setter Property="Margin" Value="0,0,0,8"/>
                    <Setter Property="Padding" Value="0"/>
                    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <Border x:Name="ItemBorder" Background="#191C1F" BorderBrush="#30353A" BorderThickness="1" CornerRadius="6">
                                    <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="ItemBorder" Property="BorderBrush" Value="#4F8EF7"/>
                                        <Setter TargetName="ItemBorder" Property="Background" Value="#162338"/>
                                    </Trigger>
                                    <MultiTrigger>
                                        <MultiTrigger.Conditions>
                                            <Condition Property="IsMouseOver" Value="True"/>
                                            <Condition Property="IsSelected" Value="False"/>
                                        </MultiTrigger.Conditions>
                                        <Setter TargetName="ItemBorder" Property="BorderBrush" Value="#425466"/>
                                        <Setter TargetName="ItemBorder" Property="Background" Value="#21272D"/>
                                    </MultiTrigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border Background="Transparent" Padding="16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Width="5" Height="38" CornerRadius="2" Background="{Binding ColorHex}"/>
                            <StackPanel Grid.Column="1" Margin="14,0">
                                <TextBlock Text="{Binding DisplayName}" ToolTip="{Binding DisplayName}" TextTrimming="CharacterEllipsis" FontSize="16" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding Email}" TextTrimming="CharacterEllipsis" FontSize="12" Foreground="#A9B0B6" Margin="0,4,0,0"/>
                                <TextBlock Text="{Binding Usage.PlanType, StringFormat={}{0} plan}" FontSize="11" Foreground="#A9B0B6" Margin="0,2,0,0">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Usage.Status}" Value="available">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Text="Protected by Windows DPAPI" FontSize="12" Foreground="#8E979F" Margin="0,4,0,0"/>
                                <TextBlock Text="Usage not checked" FontSize="11" Foreground="#A9B0B6" Margin="0,8,0,0">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Visible"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Usage.Status}" Value="available">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Usage.Status}" Value="unavailable">
                                                    <Setter Property="Text" Value="Usage unavailable"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <ItemsControl ItemsSource="{Binding Usage.Windows}" Margin="0,8,0,0">
                                    <ItemsControl.Style>
                                        <Style TargetType="ItemsControl">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Usage.Status}" Value="available">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ItemsControl.Style>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,2">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Label}" FontSize="11" Foreground="#A9B0B6"/>
                                                <ProgressBar Grid.Column="1" Value="{Binding RemainingPercent}" Maximum="100" Height="4" Margin="10,0" Foreground="#68D391" Background="#30353A"/>
                                                <TextBlock Grid.Column="2" Text="{Binding RemainingPercent, StringFormat={}{0:0}% left}" ToolTip="{Binding UsedPercent, StringFormat={}{0:0}% used}" FontSize="11" Foreground="#DCE1E5"/>
                                                <TextBlock Grid.Row="1" Text="{Binding ResetsAt, StringFormat={}{0:MMM d HH:mm} reset}" FontSize="10" Foreground="#737C84" Margin="0,2,0,0"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="{Binding Usage.CheckedAt, StringFormat={}{0:MMM d HH:mm} checked}" FontSize="10" Foreground="#737C84" Margin="0,4,0,0">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Usage.Status}" Value="available">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                            <TextBlock Grid.Column="2" Foreground="#8E979F" FontSize="10" FontWeight="Bold" VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="SAVED"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                <Setter Property="Text" Value="ACTIVE"/>
                                                <Setter Property="Foreground" Value="#68D391"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <Grid Grid.Row="4" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button x:Name="DeleteButton" Content="Delete" Click="DeleteButton_Click" Background="Transparent" Foreground="#F4A6A6" BorderBrush="#684040"/>
            <TextBlock Grid.Column="1" x:Name="StatusText" Text="Ready" Foreground="#8E979F" VerticalAlignment="Center" Margin="16,0" TextTrimming="CharacterEllipsis"/>
            <Button Grid.Column="2" x:Name="SwitchButton" Content="Switch to selected" Click="SwitchButton_Click" Background="#2563EB" Foreground="White" BorderThickness="0"/>
        </Grid>
    </Grid>
</Window>
